{
  "expo": {
    "name": "Socorro Rápido",
    "slug": "socorro-rapido",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "meuapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.socorrorapido.app",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Permita que o Socorro Rápido reconheça sua fala para pesquisar por voz.",
        "NSMicrophoneUsageDescription": "Permita que o Socorro Rápido use o microfone para pesquisar por voz."
      }
    },
    "android": {
      "package": "com.socorrorapido.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permita que o Socorro Rápido use o microfone para pesquisar por voz.",
          "speechRecognitionPermission": "Permita que o Socorro Rápido reconheça sua fala para pesquisar por voz.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b46f171f-d32d-43a3-841d-9a518ebd4cd3"
      }
    },
    "owner": "sebasten"
  }
}
